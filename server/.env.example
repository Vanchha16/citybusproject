# Copy to server/.env and fill in. Everything is optional.

# Enables AI understanding of free-text questions (Khmer/English).
# Without it the assistant uses a keyword parser.
ANTHROPIC_API_KEY=

# Override the Claude model (default: claude-opus-5-5).
# CLAUDE_MODEL=claude-opus-5-5

# Pretend the clock starts at this Phnom Penh time — handy for demos at night,
# when buses are out of service. Format HH:MM.
# DEMO_CLOCK=08:30

# PORT=8787
